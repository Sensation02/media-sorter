{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "media-sorter",
  "version": "0.2.1",
  "identifier": "dev.intercode.media-sorter",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "sort-my-media",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc1NDQ3MEUxMjdENjcyRTQKUldUa2N0WW40WEJFZGJsbktVM2V5N05YUkQySnpsUHAwc0tIZkN4WGt5QmVXd2dOTlVRWjB0RFMK",
      "endpoints": [
        "https://github.com/Sensation02/media-sorter/releases/latest/download/latest.json"
      ]
    }
  }
}
